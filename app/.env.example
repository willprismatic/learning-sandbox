# Demo App - Environment Configuration
# ================================================
# Copy this file to .env and fill in your assigned values
# from the training Notion page.

# ── Your Company Identity ──────────────────────────────
# The name of your SaaS company (shown in sidebar, login, page titles)
NEXT_PUBLIC_COMPANY_NAME=

# Your primary resource type (singular, lowercase slug).
# This controls which resource forms and data your app works with.
# Available types: invoice | lead | customer | shipment | project
#                  patient | ticket | marketing-event | campaign
NEXT_PUBLIC_RESOURCE_TYPE=

# ── Your Public URL ────────────────────────────────────
# Your assigned ngrok domain (check the Notion doc)
NEXT_PUBLIC_APP_URL=https://YOUR-DOMAIN.ngrok-free.app

# ── API Keys ───────────────────────────────────────────
# OpenAI API key (shared in the Notion doc)
OPENAI_API_KEY=

# ── Access Control ─────────────────────────────────────
# Access code to protect the app when shared via ngrok
# Supports both cookie-based browser sessions and Bearer token auth (M2M/API)
APP_ACCESS_CODE=Orby2026

# ── Integration Platform (Future Milestones) ──────────
# LEARNING: This is where you'd add your integration platform's environment variables.
# For example, with Prismatic you'd configure:
# PRISMATIC_REFRESH_TOKEN=       # API refresh token for server-side operations
# PRISMATIC_SIGNING_KEY_B64=     # Base64 signing key for JWT token generation
# PRISMATIC_ORG_ID=              # Your organization ID
# PRISMATIC_BASE_URL=https://app.prismatic.io  # Platform API endpoint
# PRISMATIC_CUSTOMER_ID=         # Customer ID for embedded SDK context
# PRISMATIC_CUSTOMER_EXT_ID=     # Customer external ID
# PRISMATIC_CUSTOMER_NAME=       # Customer display name
